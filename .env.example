# Copy to .env and fill in locally. Never commit .env. No value below is real.
# Names are declared here only where an architectural need already exists
# (docs/DECISIONS.md, docs/ACCOUNT_READINESS.md).

# --- The Graph (Sprint 1, verified live on 5 September 2026) ---
# Subgraph Studio API key. Sent only as an `Authorization: Bearer` header,
# never in a URL, and redacted from every output. Required by
# `corepack pnpm graph:probe` and `corepack pnpm graph:test:live`.
GRAPH_API_KEY=
# Optional. Base URL of the Graph endpoint; the default is the public gateway.
# Validated structurally: https only, no username or password, no query string,
# no fragment. Provenance records only the sanitized origin and path, and claims
# The Graph's gateway only when the host is gateway.thegraph.com. Not a secret.
# GRAPH_GATEWAY_URL=https://gateway.thegraph.com/api

# --- Postgres (D8: local development only; live deployment target unresolved) ---
# A passwordless URL is valid and is the simplest local setup. If a password is supplied it
# must be at least four characters after percent-decoding, so the redactor can always
# protect it; a shorter or malformed one is refused with a fixed, secret-free message.
# Standard libpq-style connection URL, read only by @cas/database (Sprint 2). Required by
# `corepack pnpm db:migrate`, `db:check`, `editorial:import`, `editorial:report` and
# `test:db`; `editorial:validate` needs no database. Validated structurally (postgres or
# postgresql scheme) and never printed; every command output passes through a redactor for
# this value. Locally a loopback URL to a database created for this project, without a
# password, is enough. The database tests create and drop only schemas named
# cas_test_<random> in the database this URL names.
DATABASE_URL=

# --- Worker command deadline (security-foundation track, decision D27) ---
# Optional. Milliseconds a worker command may run before it is aborted, its
# work rolled back, and the process exits with code 124 after a grace period.
# Defaults to the versioned ceiling in @cas/contracts RESOURCE_LIMITS.command
# (1,800,000 ms). May be lowered, never raised: a value above the ceiling or a
# value that is not a positive integer is a configuration error (exit 2).
# CAS_COMMAND_DEADLINE_MS=600000

# --- Dashboard (parallel Sprint 6 track, decision D28; speculative until audited) ---
# The one knob that changes browser-facing behaviour. `local` runs over plain HTTP
# without the cookie `Secure` attribute and without HSTS; `production` requires both.
# No third value exists.
DASHBOARD_ENVIRONMENT=local
# Where accounts, sessions, audit events, draft revisions and queue decisions live.
# `memory` is permitted only when DASHBOARD_ENVIRONMENT is local and exists for
# development and tests. `postgres` is the intended store and is PAUSED: it fails
# with a fixed message until the next migration number is allocated after the
# Sprint 5 correction (which reserves 0009). No account is provisioned by default.
DASHBOARD_ACCOUNT_STORE=memory
# Memory store only: path of the seed file the provisioning command writes. It holds
# Argon2id hashes, roles and expiries; never a password. Keep it outside the repository.
DASHBOARD_MEMORY_STORE_SEED=
# Optional. The application schema the dashboard reads; `public` by default. Tests set
# an isolated `cas_test_<random>` schema here.
# DASHBOARD_DATABASE_SCHEMA=public
# Optional. `true` only behind a trusted reverse proxy that sets X-Forwarded-For; the
# first hop then keys login throttling. Default `false`: the network key is `direct`.
# DASHBOARD_TRUST_FORWARDED_FOR=false

# --- Anthropic (D9: classification and drafting model; exact model unresolved) ---
# Read by the official Anthropic SDK.
ANTHROPIC_API_KEY=

# --- Configuration categories without a verified variable name yet ---
# The variable names for the categories below are NOT fixed. Each will be set
# in the sprint that introduces the integration, against that provider's
# current documentation. Do not invent names for them before then.
#
# Graph Market access only if an optional product path, such as Substreams,
#   actually requires it (D11). Not needed for the standardized-schema route.
# Editorial week boundary (D10): start, freeze and publication timestamps;
#   timezone provisionally America/Toronto.
# Hedera testnet operator credentials (Sprint 8, conditional on the 10 September Graph gate).
# x402 facilitator configuration, referred to as Blocky402 in the plan (Sprint 8, conditional).
# Bazantic API credentials (Sprint 8, conditional).

# --- Google Sheets intake (parallel track: read-only RSS intake) ---
# The authorized workbook is exactly one file: "Cyberattack Sunday - RSS Intake".
# Its identifier is a secret and is never committed. What IS committed is the
# SHA-256 digest of it, in data/policy/authorized-workbook.json; the connector
# refuses any other workbook, and refuses every workbook while that digest is
# null. To pin it: set this variable, run `corepack pnpm sheets:pin`, and paste
# the printed digest into the policy file. The identifier is never printed.
GOOGLE_SHEETS_SPREADSHEET_ID=

# Application Default Credentials: an absolute path to the dedicated service
# account's JSON key. It must live OUTSIDE this repository and be readable only
# by its owner (mode 0600); the connector refuses a key inside the working tree
# and a key with open permissions, because an ignore rule is not a boundary.
# The account holds no Drive access and no write scope: the owner shares one
# file with it as Viewer, and revocation is removing that share.
GOOGLE_APPLICATION_CREDENTIALS=

# Optional, and only after the owner has reviewed an inventory report: a path
# to the approved tab mapping. A tab's lineage stage is never inferred.
# GOOGLE_SHEETS_TAB_MAP=
