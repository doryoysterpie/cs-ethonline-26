# Latest in Cyber: the complete environment reference.
#
# Copy to .env and fill in locally. Never commit .env. No value below is real,
# and none may be filled in and committed.
#
# Six groups:
#
#   1. PostgreSQL
#   2. Dashboard sessions
#   3. Google Sheets read-only credentials
#   4. Graph access
#   5. MCP runtime
#   6. Deployment configuration
#
# Every name below is read by shipped code, except the one reserved name in
# group 6, which says so. A configuration rejection names the variable and the
# rule it broke; it never echoes the value, because a malformed secret is still
# a secret.

# =============================================================================
# 1. PostgreSQL
# =============================================================================
# D8: local development only. The live deployment target is unresolved.
#
# Standard libpq-style connection URL, read by @cas/database and, through it,
# by the worker, the dashboard's read side and the MCP server. Required by
# `db:migrate`, `db:check`, `editorial:import`, `editorial:report` and
# `test:db`; `editorial:validate` needs no database. Validated structurally
# (postgres or postgresql scheme), never printed, and redacted from every
# command's output.
#
# A passwordless URL is valid and is the simplest local setup. If a password is
# supplied it must be at least four characters after percent-decoding, so the
# redactor can always protect it; a shorter or malformed one is refused with a
# fixed, secret-free message.
#
# The database tests create and drop only schemas named cas_test_<random> in
# the database this URL names.
DATABASE_URL=

# =============================================================================
# 2. Dashboard sessions
# =============================================================================
# Decision D28. Accounts, sessions, audit events, draft revisions and queue
# decisions all live in the store selected here.

# Required: `local` or `production`, with no default and no third value.
# `local` omits the cookie `Secure` attribute and HSTS so the dashboard runs
# over plain HTTP on a developer's machine; `production` requires both.
DASHBOARD_ENVIRONMENT=local

# Required: `memory` or `postgres`.
#
# `memory` is refused unless DASHBOARD_ENVIRONMENT is `local`. The refusal is a
# configuration error at start-up, not a warning, so a production dashboard
# cannot run on in-memory state.
#
# `postgres` is the intended store and is PAUSED: selecting it fails with a
# fixed persistence-paused message. Its migration has no number yet; 0009
# belongs to the Sprint 5 correction. The dashboard is not deployable until
# this store exists and passes its own security tests.
#
# No account is provisioned by default, and none is provisioned by this file.
DASHBOARD_ACCOUNT_STORE=memory

# Required with the memory store, and refused with any other store: the path
# of the seed file the provisioning command writes. It holds Argon2id hashes,
# roles and expiries, and never a password. Keep it outside the repository.
DASHBOARD_MEMORY_STORE_SEED=

# Optional. The application schema the read side addresses; `public` by
# default. Must be a plain lower-case identifier. Tests set an isolated
# cas_test_<random> schema here.
# DASHBOARD_DATABASE_SCHEMA=public

# Optional: `true` or `false`, default `false`. Set `true` only behind a
# trusted reverse proxy that sets X-Forwarded-For; the first hop then keys
# login throttling. With `false` every attempt is keyed as `direct`, because an
# X-Forwarded-For header from an untrusted client is whatever the client chose
# to send.
# DASHBOARD_TRUST_FORWARDED_FOR=false

# =============================================================================
# 3. Google Sheets read-only credentials
# =============================================================================
# The authorized workbook is exactly one file: "Cyberattack Sunday - RSS
# Intake". The connector uses the Google Sheets API only, requests only the
# spreadsheets.readonly scope, has no Drive dependency, and has no method that
# writes. See docs/SHEETS-INTAKE.md.
#
# The connector is INACTIVE in this release: the pinned digest in
# data/policy/authorized-workbook.json is null, and every Sheets command
# refuses while it stays null.

# Required by every Sheets command. The workbook's bare identifier, not a URL.
# A secret: never committed, never printed. What is committed instead is its
# SHA-256 digest. To pin it, set this variable and run
# `corepack pnpm sheets:pin`, which prints the digest and nothing else, then
# put that digest in the policy file in its own reviewed commit. Authorizing a
# different workbook is therefore a reviewed code change, not a configuration
# change.
GOOGLE_SHEETS_SPREADSHEET_ID=

# Required by every Sheets command except `sheets:pin`. The Application
# Default Credentials name: an absolute path to the dedicated service
# account's JSON key. The key must live OUTSIDE this repository and be readable
# only by its owner (mode 0600). A key inside the working tree is refused
# whatever .gitignore says, and so is a key with open permissions.
#
# The service account holds no project roles and no Drive access. Its entire
# grant is one file shared with it as Viewer; revocation is removing that
# share.
GOOGLE_APPLICATION_CREDENTIALS=

# Optional, and only after the owner has reviewed an inventory report: a path
# to the approved tab mapping. A tab's lineage stage is never inferred.
# GOOGLE_SHEETS_TAB_MAP=

# =============================================================================
# 4. Graph access
# =============================================================================
# Sprint 1, verified live on 5 September 2026.

# Subgraph Studio API key. Sent only as an `Authorization: Bearer` header,
# never in a URL, and redacted from every output. Required by
# `corepack pnpm graph:probe`, `corepack pnpm graph:test:live` and the MCP
# server's live mode; without it live mode fails with a fixed code and never
# falls back to stored or replayed data.
GRAPH_API_KEY=

# Optional. Base URL of the Graph endpoint; the default is the public gateway.
# Validated structurally: https only, no username or password, no query string,
# no fragment, and refused if it contains the active credential. Provenance
# records only the sanitized origin and path, and claims The Graph's gateway
# only when the host is gateway.thegraph.com. Not a secret.
# GRAPH_GATEWAY_URL=https://gateway.thegraph.com/api

# =============================================================================
# 5. MCP runtime
# =============================================================================
# Decision D29. The server speaks stdio only. NO REMOTE MCP SERVICE IS ENABLED,
# and enabling one is a separate decision with its own security review.
#
# The server reads exactly four names: DATABASE_URL (group 1), GRAPH_API_KEY
# and GRAPH_GATEWAY_URL (group 4), and CAS_MCP_MODE below. It never emits
# their values. Without DATABASE_URL the stored tools fail with a fixed code.

# Optional: `production` or `development`, default `production`; any other
# value is rejected at start-up.
#
# `production` requires the database credential to be a dedicated reader role.
# An eighteen-check privilege matrix covering role attributes, database and
# schema privileges, ownership and table access runs at start-up and again on
# each stored call's own connection before any application read; an
# overprivileged credential fails closed. The role is created by the operator
# script packages/mcp-server/sql/mcp-reader-role.sql, never by a migration.
#
# `development` runs and logs the same check but does not refuse an
# overprivileged local credential. Never use it outside a developer's machine.
# CAS_MCP_MODE=production

# =============================================================================
# 6. Deployment configuration
# =============================================================================
# Nothing in this repository is deployed, and nothing here enables a
# deployment.

# Optional. Milliseconds a worker command may run before it is aborted, its
# work rolled back, and the process exits with code 124 after a grace period.
# Defaults to the versioned ceiling in @cas/contracts RESOURCE_LIMITS.command
# (1,800,000 ms). May be lowered, never raised: a value above the ceiling, or a
# value that is not a positive integer, is a configuration error (exit 2).
# Decision D27.
# CAS_COMMAND_DEADLINE_MS=600000

# --- Reserved name, read by no code in this release -------------------------
# D9 is unresolved. No model SDK is a dependency, no model is called, and the
# classifier and drafter are deterministic. This name is reserved for the
# official Anthropic SDK and stays empty until D9 is decided.
ANTHROPIC_API_KEY=

# --- Categories with no verified variable name yet --------------------------
# Each name is set in the sprint that introduces the integration, against that
# provider's current documentation. Do not invent names for them before then.
#
# Graph Market access, only if an optional product path such as Substreams
#   actually requires it (D11). Not needed for the standardized-schema route.
# Editorial week boundary (D10): start, freeze and publication timestamps;
#   timezone provisionally America/Toronto.
# Hosting target, TLS termination and the trusted reverse proxy that
#   DASHBOARD_TRUST_FORWARDED_FOR depends on (D8, unresolved).
# Hedera testnet operator credentials (Sprint 8, conditional on the Graph gate).
# x402 facilitator configuration, referred to as Blocky402 in the plan
#   (Sprint 8, conditional).
# Bazantic API credentials (Sprint 8, conditional).
