;; A macOS sandbox profile that denies every network operation and nothing
;; else. Used to demonstrate that the default test suite is genuinely offline
;; rather than merely believed to be:
;;
;;   sandbox-exec -f tools/offline-sandbox.sb \
;;     corepack pnpm exec turbo run test --force --filter=!@cas/mcp-server
;;
;; The denial is demonstrated to be active in the same session by attempting a
;; connection under the same profile and requiring it to fail:
;;
;;   sandbox-exec -f tools/offline-sandbox.sb node -e \
;;     "require('node:net').connect(443,'1.1.1.1').on('error',e=>console.log(e.code))"
;;
;; It denies UNIX-domain sockets too, so the PostgreSQL integration suite
;; cannot run under it. That is the point: the suite must pass here and
;; `pnpm test:db` must not be able to.
;;
;; `@cas/mcp-server` is excluded above because two of its files need a
;; loopback socket, which this profile denies along with everything else:
;; `src/redirect.stdio.test.ts` serves real synthetic HTTP and HTTPS
;; redirects from 127.0.0.1 to prove the gateway refuses every one of them,
;; and `src/stdio.test.ts` asserts the fixed start-up line for an unreachable
;; database, whose reason is derived from the refusal the operating system
;; returns. Run the whole default suite under `tools/loopback-sandbox.sb`
;; instead, which denies every host off this machine and allows loopback
;; only. Running `corepack pnpm test --force` under this profile fails those
;; two files with `EPERM` on `listen` and on `connect`; that is the profile
;; working, not the suite reaching the network.
(version 1)
(allow default)
(deny network*)
