{
  "name": "cs-ethonline-26",
  "version": "0.0.0",
  "private": true,
  "description": "Cyberattack Sunday: Onchain Incident Intelligence (working name CAS Chainwatch). ETHOnline 2026 monorepo.",
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck && tsc -p tools/tsconfig.json",
    "test": "turbo run test",
    "test:tools": "vitest run --config tools/vitest.config.ts",
    "build": "turbo run build",
    "check:repo": "node tools/checks/hygiene.ts && node tools/checks/forbidden-files.ts && node tools/checks/secrets.ts && node tools/checks/workflows.ts",
    "check:toolchain": "node tools/checks/toolchain.ts",
    "test:offline-enforced": "bash tools/checks/network-denial.sh pnpm test --force",
    "audit:deps": "pnpm audit --audit-level=low",
    "supply-chain:generate": "node tools/supply-chain/sbom.ts",
    "supply-chain:check": "node tools/supply-chain/sbom.ts --check --cross-check",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:tools && pnpm check:repo && pnpm build",
    "graph:probe": "pnpm --filter @cas/graph-evidence probe:live",
    "graph:test:live": "pnpm --filter @cas/graph-evidence test:live",
    "db:migrate": "pnpm -s --filter @cas/worker cli db migrate",
    "db:check": "pnpm -s --filter @cas/worker cli db check",
    "editorial:validate": "pnpm -s --filter @cas/worker cli editorial validate",
    "editorial:import": "pnpm -s --filter @cas/worker cli editorial import",
    "editorial:report": "pnpm -s --filter @cas/worker cli editorial report",
    "classify:run": "pnpm -s --filter @cas/worker cli classification run",
    "classify:report": "pnpm -s --filter @cas/worker cli classification report",
    "classify:queue": "pnpm -s --filter @cas/worker cli classification queue",
    "classify:calibrate": "pnpm -s --filter @cas/worker cli classification calibrate",
    "sheets:pin": "pnpm -s --filter @cas/worker cli sheets pin",
    "sheets:inventory": "pnpm -s --filter @cas/worker cli sheets inventory",
    "sheets:timestamps": "pnpm -s --filter @cas/worker cli sheets timestamps",
    "sheets:dry-run": "pnpm -s --filter @cas/worker cli sheets dry-run",
    "test:db": "pnpm --filter @cas/database test:db && pnpm --filter @cas/worker test:db"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
