{
  "name": "@cas/mcp-server",
  "version": "0.0.0",
  "private": true,
  "description": "Read-only MCP tooling over the incident store: list_incidents, explain_incident, chain_anomalies and draft_section over local stdio only. Parallel MCP tooling track (decision D28), pending independent audit.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.build.json && vitest run",
    "test:db": "pnpm -w exec turbo run build --filter=@cas/mcp-server && vitest run --config vitest.db.config.ts",
    "start": "node dist/bin.js"
  },
  "dependencies": {
    "@cas/contracts": "workspace:*",
    "@cas/database": "workspace:*",
    "@cas/drafting": "workspace:*",
    "@cas/evidence": "workspace:*",
    "@cas/graph-evidence": "workspace:*",
    "@modelcontextprotocol/server": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "bin": {
    "cas-mcp-server": "./dist/bin.js"
  }
}
